# Public canonical URL for metadata, sitemap, and robots.txt
NEXT_PUBLIC_SITE_URL=https://your-real-domain.example

# Optional public contact links shown in the global footer
NEXT_PUBLIC_CONTACT_EMAIL=your-contact-email@example.com
NEXT_PUBLIC_PHONE_NUMBER=+8801XXXXXXXXX

# Contact form delivery via Resend (server-side secrets; never expose these as NEXT_PUBLIC variables)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Relax Studio <contact@your-verified-domain.example>
CONTACT_EMAIL=your-inbox@example.com
